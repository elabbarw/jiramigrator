FROM python:3.12-slim-bullseye

WORKDIR /app

# Install wkhtmltopdf and all dependencies in a single layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    xfonts-base \
    xfonts-75dpi \
    fontconfig \
    libc6 \
    libfreetype6 \
    libjpeg62-turbo \
    libpng16-16 \
    libssl1.1 \
    libstdc++6 \
    libx11-6 \
    libxcb1 \
    libxext6 \
    libxrender1 \
    libfontconfig1 \
    zlib1g \
    && wget -q https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-2/wkhtmltox_0.12.6.1-2.bullseye_amd64.deb \
    && dpkg -i wkhtmltox_0.12.6.1-2.bullseye_amd64.deb || apt-get install -f -y \
    && rm wkhtmltox_0.12.6.1-2.bullseye_amd64.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Download spaCy models - try medium first, fallback to small
RUN python -m spacy download en_core_web_md || python -m spacy download en_core_web_sm || echo "Warning: spaCy model download failed"

# Copy project files
COPY . .

# wkhtmltopdf is now installed system-wide via apt

# Set PYTHONPATH to include the app directory so jiramigration is importable
ENV PYTHONPATH=/app:$PYTHONPATH

# Create data directory
RUN mkdir -p /app/data

# Command to run the worker - this will be overridden by docker-compose
CMD ["celery", "-A", "app.celery.celery_app", "worker", "--loglevel=info"] 